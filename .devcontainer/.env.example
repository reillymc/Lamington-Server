# Lamington service settings
PORT=3000
PAGE_SIZE=50 # Applies to all paginated endpoints. Default: `50`.
LOG_LEVEL=tiny # Applies to console and log files. Options: `tiny` | `short` | `dev`. Default: `tiny`.
ATTACHMENT_STORAGE_SERVICE=localdisk # Options: `localdisk` (./uploads) | `s3` (any S3-compatible object storage, requires additional setup below). Default: `localdisk`.
ATTACHMENT_PATH= # Optional storage prefix for uploads. No leading/trailing slashes. Applies to local disk paths, object storage keys and public URLs. e.g. `dev/attachments` or `prod/attachments`
EXTERNAL_HOST=http://localhost:3000 # External host URL for generating links. No trailing slash.
CORS_ALLOWED_ORIGIN=http://localhost:8082 # URL lamington client web is hosted at to enforce CORS origin. No trailing slash.
UPLOAD_DIRECTORY=uploads
ASSET_DIRECTORY=assets
LOG_DIRECTORY=logs

# Database details - must be set to desired values BEFORE first run
DB_DEV_NAME=lamingtondb
DB_DEV_USER=postgres
DB_DEV_PASSWORD=password
DB_DEV_HOST=db_development # docker-compose service name or ip if in host network mode

DB_TEST_NAME=lamingtondb
DB_TEST_USER=postgres
DB_TEST_PASSWORD=password
DB_TEST_HOST=db_testing # docker-compose service name or ip if in host network mode

PGPORT=5432

# Admin Account - will be generated based on values on first run
ADMIN_ACCOUNT_NAME="admin@lamington.example"
ADMIN_ACCOUNT_PASSWORD="lamington"

# JWT secret key for user authentication
JWT_SECRET=secret
JWT_REFRESH_SECRET=different_secret

# S3-compatible object storage details (only required if ATTACHMENT_STORAGE_SERVICE=`s3`).
# Works with any S3 API-compatible provider, e.g. Backblaze B2.
S3_ACCESS_KEY_ID=xxxx
S3_SECRET_ACCESS_KEY=xxx+xx+xxxx
S3_BUCKET_NAME=lamington-bucket-name
S3_REGION=us-west-004
# Optional custom endpoint. Required for providers other than AWS, e.g. Backblaze B2.
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# Use path-style addressing (bucket in the path). Required for Backblaze B2. Default: `false`.
S3_FORCE_PATH_STYLE=true
# Public CDN/bucket root returned directly as attachment `uri` values (e.g. a Cloudflare CDN domain in front of the bucket). No signing is performed. No trailing slash.
ATTACHMENT_PUBLIC_BASE_URL=https://cdn.example.com

# Worktree isolation (auto-generated - do not set by hand)
WORKTREE_SLUG=master
GIT_REPO=/path/to/Lamington-Server/.git

