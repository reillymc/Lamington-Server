        {
            "previewLimit": 50,
            "server": "db_development",
            "port": 5432,
            "driver": "PostgreSQL",
            "name": "Development",
            "database": "lamingtondb",
            "username": "postgres",
            "password": "password"
        },
        {
            "previewLimit": 50,
            "server": "db_testing",
            "port": 5432,
            "driver": "PostgreSQL",
            "name": "Testing",
            "database": "lamingtondb",
            "username": "postgres",
            "password": "password"
