{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "watch:tsc",
            "type": "shell",
            "command": "mkdir -p .quality/logs && npm run typecheck:watch 2>&1 | tee .quality/logs/typecheck.log",
            "problemMatcher": {
                "base": "$tsc-watch",
                "applyTo": "allDocuments"
            },
            "group": "build",
            "icon": {
                "id": "bracket-dot"
            },
            "presentation": {
                "reveal": "never",
                "echo": false,
                "focus": false,
                "panel": "dedicated"
            },
            "isBackground": true,
            "runOptions": {
                "runOn": "folderOpen",
                "instanceLimit": 1,
                "instancePolicy": "silent"
            }
        },
        {
